{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.dummy.movement": {
            "initial_state": "default",
            "states": {
                "default": {
                    "animations": [
                        {
                            "walk": "query.modified_move_speed"
                        },
                        {
                            "idle": "1.0 - math.min(query.modified_move_speed, 1.0)"
                        }
                    ],
                    "blend_transition": 0.2
                }
            }
        }
    }
}